# Keep Tailwind v4's PostCSS plugin out of the hoisted store dir. Otherwise
# vue-lynx in `app` can resolve it there and print a false "detected
# @tailwindcss/postcss / incompatible with Tailwind v3" warning, even though
# `app` builds with Tailwind v3.
hoist-pattern[]=*
hoist-pattern[]=!@tailwindcss/postcss
