# Copy to .env and fill in. docker compose reads this file automatically.
# .env is gitignored; .env.example is committed.

# ---- Stripe (optional — leave blank to run without payments) ----
# Consumed by docker-compose.yml -> api service.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- API configuration overrides ----
# The API binds config from appsettings*.json; any key can be overridden with a
# double-underscore env var. Compose sets ConnectionStrings__Default for you.
# Set these in production (Terraform wires them on Azure Container Apps):

# Postgres connection string (Npgsql format).
# ConnectionStrings__Default=Host=db;Database=picknic;Username=picknic;Password=picknic

# Guest JWT signing key — REQUIRED outside Development (>= 32 bytes).
# Auth__Guest__SigningKey=

# Azure Blob Storage account (empty disables photo storage/upload).
# Storage__AccountUrl=https://<account>.blob.core.windows.net/
# Storage__Container=photos

# Data Protection key ring persistence (empty = local dev key store).
# DataProtection__BlobUri=https://<account>.blob.core.windows.net/dataprotection-keys/keys.xml
# DataProtection__KeyVaultKeyId=https://<vault>.vault.azure.net/keys/<key>

# Public web origin — used for join links and CORS.
# Web__BaseUrl=https://app.example.com
# Cors__AllowedOrigins=https://app.example.com

# Transactional email via Azure Communication Services (empty = log only).
# Email__ConnectionString=
# Email__FromAddress=no-reply@example.com

# Shared secret Event Grid presents (?code=…) on the blob-created webhook.
# Terraform generates and wires this on Azure; only needed if self-hosting events.
# EventGrid__Secret=

# ---- Web (Nuxt) ----
# Base URL the web app calls the API on (compose sets this to http://api:8080).
# NUXT_API_BASE=http://localhost:5000
